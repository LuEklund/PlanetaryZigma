#!/usr/bin/env bash
# pz build | run [menu|dev|singleplayer|run] | shot [out.png] [scale] | log [pattern] | cmd "/command" | kill
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
logfile="${PZ_LOG:-/tmp/pz-client.log}"
console="${PZ_CONSOLE:-/tmp/pz-console}"

window_geometry() {
    hyprctl clients -j | python3 -c '
import json, sys
for c in json.load(sys.stdin):
    if c["class"] == "planetary_zigma" and c["title"] == "PlanetaryZigma":
        print("%d,%d %dx%d" % (c["at"][0], c["at"][1], c["size"][0], c["size"][1]))
        break'
}

case "${1:-}" in
    build)
        (cd "$root/client" && zig build 2>&1 | grep -E "error|note" || true)
        (cd "$root/server" && zig build 2>&1 | grep -E "error|note" || true) ;;
    run)
        pkill -x client || true; pkill -x server || true; sleep 1
        mode="${2:-dev}"
        cd "$root/client"
        : >"$console"
        if [ "$mode" = menu ]; then PZ_CONSOLE="$console" ./zig-out/bin/client >"$logfile" 2>&1 &
        else PZ_CONSOLE="$console" PZ_AUTOSTART="$mode" ./zig-out/bin/client >"$logfile" 2>&1 & fi
        for _ in $(seq 1 60); do sleep 0.5; [ -n "$(window_geometry)" ] && break; done
        sleep "${PZ_SETTLE:-8}"; echo "running, log: $logfile" ;;
    shot)
        geometry="$(window_geometry)"
        [ -z "$geometry" ] && { echo "game window not found" >&2; exit 1; }
        grim -g "$geometry" -s "${3:-0.6}" "${2:-/tmp/pz-shot.png}"; echo "${2:-/tmp/pz-shot.png}" ;;
    log)
        grep -a -v "^VK:" "$logfile" | grep -a -E "${2:-error|warning|panic|VUID|DeviceLost}" | cut -c1-300 | sort | uniq -c | sort -rn | head -30 || true ;;
    cmd)
        shift; printf '%s\n' "$@" >>"$console"; sleep 1
        grep -a "chat server:" "$logfile" | tail -n "$#" ;;
    kill)
        pkill -x client || true; pkill -x server || true ;;
    *) sed -n 2p "$0"; exit 1 ;;
esac
